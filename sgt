/* ---- MBA page additions: track matcher, track deep-dives, term sheet, essentials ---- */
.matcher{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-l);padding:clamp(20px,3vw,30px);box-shadow:14px -14px 0 0 var(--cobalt),var(--shadow);margin:14px 14px 0 0;display:grid;gap:16px}
