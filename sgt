<script>/* Shared enquiry-form engine. Every form on the page (hero "h-" and apply section "f-") runs the same OTP flow. */
window.__sgtInitForms = function (o) {
  "use strict";
  const PREFIXES = ["h", "f"].filter((p) => document.getElementById(p + "-enquiry"));
  const el = (p, id) => document.getElementById(`${p}-${id}`);
  const where = (p) => (p === "h" ? "hero" : "apply_section");
  const post = async (url, body) => {
    const r = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    let j = {}; try { j = await r.json(); } catch (_) {}
    if (!r.ok) throw new Error(j.message || "Something went wrong. Please try again.");
    return j;
  };
  const baseRules = {
    name: (v) => /^[A-Za-z][A-Za-z .'-]{1,99}$/.test(v.trim()) || "Enter your full name using letters only.",
    mobile: (v) => /^[6-9]\d{9}$/.test(v) || "Enter a 10-digit Indian mobile number starting with 6, 7, 8 or 9.",
    email: (v) => /^[^\s@]+@[^\s@]+\.[A-Za-z]{2,}$/.test(v.trim()) || "Enter an email like name@example.com.",
    state: (v) => !!v || "Select your state.",
    city: (v) => !!v || "Select your city."
  };
  const rules = Object.assign({}, baseRules, o.rules, { consent: (_, x) => x.checked || "Tick the box so our counsellor can contact you." });

  function initForm(p) {
    const form = el(p, "enquiry"), sState = el(p, "state"), sCity = el(p, "city");
    Object.keys(o.cities).sort().forEach((st) => sState.add(new Option(st, st)));
    sState.addEventListener("change", () => {
      sCity.innerHTML = ""; sCity.add(new Option("Select your city", ""));
      (o.cities[sState.value] || []).forEach((c) => sCity.add(new Option(c, c)));
      sCity.add(new Option("Other", "Other")); sCity.disabled = !sState.value;
    });
    if (o.setup) o.setup(p, el);

    const check = (k) => {
      const x = el(p, k), res = rules[k](x.value, x), err = el(p, k + "-err"), bad = res !== true;
      x.setAttribute("aria-invalid", String(bad)); if (err) err.textContent = bad ? res : ""; return !bad;
    };
    Object.keys(rules).forEach((k) => {
      const x = el(p, k);
      x.addEventListener("blur", () => { if (x.value || x.type === "checkbox") check(k); });
      x.addEventListener("change", () => check(k));
    });
    el(p, "mobile").addEventListener("input", (e) => { e.target.value = e.target.value.replace(/\D/g, "").slice(0, 10); });

    const status = el(p, "form-status"), otpBox = el(p, "otp-box"), otpInput = el(p, "otp"),
          sendBtn = el(p, "send-otp"), verifyBtn = el(p, "verify-otp"), timerEl = el(p, "otp-timer");
    let timer = null, secs = 0;
