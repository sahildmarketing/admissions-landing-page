      if (!/^\d{4}$/.test(otpInput.value)) { el(p, "otp-err").textContent = "Enter the 4-digit OTP."; otpInput.focus(); return; }
      el(p, "otp-err").textContent = ""; verifyBtn.disabled = true; status.textContent = "Verifying…";
      const lead = Object.assign({ name: el(p, "name").value.trim(), mobile: el(p, "mobile").value, email: el(p, "email").value.trim() },
        meta(), { consent: true, page: location.href.split("?")[0], submitted_at: new Date().toISOString() }, o.utm);
      try {
        if (o.live) { await post(o.cfg.otpVerifyUrl, { mobile: lead.mobile, otp: otpInput.value }); await post(o.cfg.leadUrl, lead); }
        else if (otpInput.value !== "1234") throw new Error("That OTP doesn’t match. In preview mode, use 1234.");
        clearInterval(timer); o.track("lead_form_success", meta());
        form.hidden = true; const done = el(p, "form-success"); done.hidden = false;
        el(p, "success-name").textContent = lead.name.split(" ")[0];
        el(p, "success-prog").textContent = o.successLabel(p, el);
        done.focus();
        if (o.cfg.thankYouUrl) setTimeout(() => { location.href = o.cfg.thankYouUrl; }, 1800);
      } catch (err) { status.textContent = err.message; verifyBtn.disabled = false; }
    });
    if (!o.live) el(p, "preview-note").hidden = false;
  }
  PREFIXES.forEach(initForm);

  /* scroll to whichever form is nearest the visitor right now */
  function focusNearest() {
    const cards = PREFIXES.map((p) => el(p, "enquiry").closest(".form-card")).filter((c) => !c.querySelector("form[hidden]"));
    if (!cards.length) return;
    cards.sort((a, b) => Math.abs(a.getBoundingClientRect().top) - Math.abs(b.getBoundingClientRect().top));
    const p = cards[0].dataset.form;
    cards[0].scrollIntoView({ behavior: o.reduceMotion ? "auto" : "smooth", block: "start" });
    setTimeout(() => el(p, "name").focus({ preventScroll: true }), o.reduceMotion ? 0 : 600);
  }
  return { prefixes: PREFIXES, el, focusNearest };
};

/* Shared runtime for the story pages: config, analytics, UTM capture, video lightbox, helpers. */
(() => {
  "use strict";
  const CFG = Object.assign({ gtmId: "GTM-XXXXXXX", otpRequestUrl: "", otpVerifyUrl: "", leadUrl: "", thankYouUrl: "" }, window.SGT_CONFIG || {});
  const LIVE = !!(CFG.otpRequestUrl && CFG.otpVerifyUrl && CFG.leadUrl);
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  window.dataLayer = window.dataLayer || [];
  const track = (event, extra = {}) => window.dataLayer.push({ event, ...extra });
  if (CFG.gtmId && !/X{4,}/.test(CFG.gtmId)) {
    window.dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
    const s = document.createElement("script"); s.async = true;
    s.src = "https://www.googletagmanager.com/gtm.js?id=" + encodeURIComponent(CFG.gtmId);
    document.head.appendChild(s);
  }
  document.addEventListener("click", (e) => {
    const el = e.target.closest("[data-cta]");
    if (el) track("cta_click", { cta: el.getAttribute("data-cta"), cta_text: el.textContent.trim().slice(0, 60) });
  });

  const UTM_KEYS = ["utm_source","utm_medium","utm_campaign","utm_term","utm_content","gclid","fbclid","msclkid"];
  const utm = {};
  try {
    const q = new URLSearchParams(location.search); let stored = {};
    try { stored = JSON.parse(sessionStorage.getItem("sgt_utm") || "{}"); } catch (_) {}
    UTM_KEYS.forEach((k) => { utm[k] = q.get(k) || stored[k] || ""; });
    try { sessionStorage.setItem("sgt_utm", JSON.stringify(utm)); } catch (_) {}
  } catch (_) { UTM_KEYS.forEach((k) => (utm[k] = "")); }

  /* video lightbox: videos play on this page, never on another site */
  const PREVIEW = !!window.__SGT_PREVIEW;
  let vmodal = null, lastFocus = null;
  function closeVideo() { if (!vmodal) return; vmodal.hidden = true; vmodal.querySelector(".vmodal-frame").innerHTML = ""; if (lastFocus) lastFocus.focus(); }
  function openVideo(id, title) {
    if (!vmodal) {
      vmodal = document.createElement("div");
      vmodal.className = "vmodal"; vmodal.hidden = true;
      vmodal.setAttribute("role", "dialog"); vmodal.setAttribute("aria-modal", "true"); vmodal.setAttribute("aria-label", "Video player");
      vmodal.innerHTML = '<div class="vmodal-box"><button type="button" class="vmodal-close" aria-label="Close video">×</button><div class="vmodal-frame"></div><p class="vmodal-title"></p></div>';
      document.body.appendChild(vmodal);
      vmodal.addEventListener("click", (e) => { if (e.target === vmodal || e.target.closest(".vmodal-close")) closeVideo(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && vmodal && !vmodal.hidden) closeVideo(); });
    }
    lastFocus = document.activeElement;
    const frame = vmodal.querySelector(".vmodal-frame");
    if (PREVIEW) frame.innerHTML = '<p class="vmodal-note">This video plays right here on the live page.</p>';
    else {
      const f = document.createElement("iframe");
      f.src = "https://www.youtube-nocookie.com/embed/" + encodeURIComponent(id) + "?autoplay=1&rel=0&modestbranding=1&playsinline=1";
      f.title = title; f.allow = "autoplay; encrypted-media; picture-in-picture"; f.allowFullscreen = true;
      frame.innerHTML = ""; frame.appendChild(f);
    }
    vmodal.querySelector(".vmodal-title").textContent = title;
    vmodal.hidden = false; vmodal.querySelector(".vmodal-close").focus();
    track("video_play", { video_id: id, video_title: title });
  }
  document.addEventListener("click", (e) => {
    const t = e.target.closest("[data-play], .video, .event-video[data-yt]");
    if (!t) return;
    const src = t.matches("[data-play], [data-yt]") ? t : t.querySelector("[data-yt]");
    const id = src && (src.dataset.play || src.dataset.yt);
    if (id) { e.preventDefault(); openVideo(id, src.dataset.title || "SGT University video"); }
  });

  /* copy helpline */
  $$("[data-copy]").forEach((b) => b.addEventListener("click", async () => {
    try { await navigator.clipboard.writeText(b.getAttribute("data-copy")); b.textContent = "Copied"; }
    catch (_) { const t = document.getElementById(b.getAttribute("aria-controls")); if (t) { const r = document.createRange(); r.selectNodeContents(t); const s = getSelection(); s.removeAllRanges(); s.addRange(r); } b.textContent = "Selected"; }
    setTimeout(() => (b.textContent = "Copy"), 1800);
  }));

  /* reading progress + active chapter in the story map */
  const bar = $(".read-progress");
  const chapters = $$("[data-chapter]");
  const mapLinks = $$(".story-map a");
  const onScroll = () => {
    const h = document.documentElement.scrollHeight - innerHeight;
    if (bar) bar.style.transform = `scaleX(${h > 0 ? Math.min(scrollY / h, 1) : 0})`;
    let current = "";
    chapters.forEach((c) => { if (c.getBoundingClientRect().top < innerHeight * 0.45) current = c.id; });
    mapLinks.forEach((a) => a.classList.toggle("is-active", a.getAttribute("href") === "#" + current));
  };
  addEventListener("scroll", onScroll, { passive: true }); onScroll();

  /* image fallbacks */
  $$("figure.shot img").forEach((img) => img.addEventListener("error", () => {
    const fig = img.closest("figure"); img.remove(); fig.classList.add("art");
    if (window.__SGT_FALLBACK_ICON && !fig.querySelector("svg")) fig.insertAdjacentHTML("afterbegin", window.__SGT_FALLBACK_ICON);
  }, { once: true }));
  $$(".video-thumb img, .logo img").forEach((img) => img.addEventListener("error", () => {
    const logo = img.closest(".logo"); if (logo) { logo.textContent = img.alt.replace(/ logo.*$/, ""); logo.classList.add("logo-text"); } else img.remove();
  }, { once: true }));

  const yr = $("#year"); if (yr) yr.textContent = new Date().getFullYear();
  window.SGT = { CFG, LIVE, $, $$, reduceMotion, track, utm };
})();

(() => {
  "use strict";
  const { CFG, LIVE, $, $$, reduceMotion, track, utm } = window.SGT;
  const DATA = window.__SGT_DATA;
  const norm = (s) => (s || "").toLowerCase().normalize("NFKD").replace(/[^a-z0-9]/g, "");
  /* ---------- programme index ---------- */
  const LEVELS = { B: "Bachelor's", M: "Master's", D: "Doctoral", C: "Diploma / Certificate" };
  const PROGS = [];
  DATA.faculties.forEach((f, fi) => f.programmes.forEach(([name, lvl, alias]) => {
    PROGS.push({ id: `${fi}-${PROGS.length}`, name, lvl, fac: f.name, fi, key: norm(name + " " + f.name + " " + (alias || "") + " " + (f.alias || "")) });
  }));

  /* ---------- hero finder ---------- */
  const fInput = $("#finder-q"), fList = $("#finder-results"), fCount = $("#finder-count");
  let fLevel = "all";
  const POPULAR = DATA.popular;
  function renderFinder() {
    const q = norm(fInput.value);
    let rows = PROGS.filter((p) => (fLevel === "all" || p.lvl === fLevel) && (!q || p.key.includes(q)));
    if (!q && fLevel === "all") rows = POPULAR.map((n) => PROGS.find((p) => p.name === n)).filter(Boolean);
    fCount.textContent = q || fLevel !== "all" ? `${rows.length} match${rows.length === 1 ? "" : "es"}` : "Popular picks";
    fList.innerHTML = "";
    if (!rows.length) {
      const li = document.createElement("li");
      li.className = "results-empty";
      li.textContent = "No sample programme matches that yet. Ask admissions: SGT runs 200+ programmes.";
      fList.appendChild(li);
      return;
    }
    rows.slice(0, 40).forEach((p) => {
      const li = document.createElement("li");
      li.className = "result";
      li.innerHTML = `<div><div class="result-name"></div><div class="result-meta"></div></div><button type="button" data-cta="finder-enquire">Enquire</button>`;
      li.querySelector(".result-name").textContent = p.name;
      li.querySelector(".result-meta").textContent = `${LEVELS[p.lvl]} · ${p.fac}`;
      li.querySelector("button").addEventListener("click", () => chooseProgramme(p));
      fList.appendChild(li);
    });
  }
  fInput.addEventListener("input", renderFinder);
  $$("#finder-levels .chip").forEach((c) => c.addEventListener("click", () => {
    fLevel = c.dataset.level;
    $$("#finder-levels .chip").forEach((x) => x.setAttribute("aria-pressed", String(x === c)));
    renderFinder();
  }));
  renderFinder();

  // rotating placeholder
  const hints = DATA.hints;
  let hi = 0, hintTimer = null;
  const setHint = () => { fInput.placeholder = `Try “${hints[hi++ % hints.length]}”`; };
  setHint();
  if (!reduceMotion) {
    hintTimer = setInterval(() => { if (document.activeElement !== fInput && !fInput.value) setHint(); }, 2400);
  }


  /* faculty chips filter the finder */
  $$(".chips-cloud button").forEach((b) => b.addEventListener("click", () => {
    const on = b.getAttribute("aria-pressed") !== "true";
    $$(".chips-cloud button").forEach((x) => x.setAttribute("aria-pressed", "false"));
    b.setAttribute("aria-pressed", String(on));
    fInput.value = on ? b.dataset.fac : "";
    renderFinder();
    track("faculty_filter", { faculty: on ? b.dataset.fac : "" });
  }));

  /* ---------- enquiry forms (hero + apply section) ---------- */
  function fillProgrammes(sProg, level, keep) {
    sProg.innerHTML = "";
    sProg.add(new Option(level ? "Select a programme" : "Choose a level first", ""));
    if (!level) { sProg.disabled = true; return; }
    DATA.faculties.forEach((f) => {
      const list = PROGS.filter((p) => p.fac === f.name && p.lvl === level);
      if (!list.length) return;
      const g = document.createElement("optgroup"); g.label = f.name;
      list.forEach((p) => g.appendChild(new Option(p.name, `${p.fac} | ${p.name}`)));
      sProg.appendChild(g);
    });
    sProg.add(new Option("Not sure yet: help me choose", "Undecided"));
    sProg.disabled = false;
    if (keep) sProg.value = keep;
  }
  const FORMS = window.__sgtInitForms({
    live: LIVE, cfg: CFG, utm, track, reduceMotion, cities: DATA.cities,
    rules: { level: (v) => !!v || "Select a study level.", prog: (v) => !!v || "Select a programme, or choose “Not sure yet”." },
    setup: (p, el) => { const sl = el(p, "level"), sp = el(p, "prog"); sl.addEventListener("change", () => fillProgrammes(sp, sl.value)); fillProgrammes(sp, ""); },
    meta: (p, el) => { const v = el(p, "prog").value || ""; const [fac, prog] = v.split(" | "); return { programme: prog || v, faculty: prog ? fac : "", level: LEVELS[el(p, "level").value] || "" }; },
    successLabel: (p, el) => { const v = el(p, "prog").value; return v === "Undecided" ? "the right programme" : (v.split(" | ")[1] || v); }
  });
  function chooseProgramme(p) {
    FORMS.prefixes.forEach((x) => {
      FORMS.el(x, "level").value = p.lvl;
      fillProgrammes(FORMS.el(x, "prog"), p.lvl, `${p.fac} | ${p.name}`);
      const c = FORMS.el(x, "chosen"); if (c) { c.hidden = false; c.querySelector("b").textContent = p.name; }
    });
    track("programme_select", { programme: p.name, faculty: p.fac, level: LEVELS[p.lvl] });
    FORMS.focusNearest();
  }
  document.addEventListener("click", (e) => { const a = e.target.closest("[data-nearest]"); if (a) { e.preventDefault(); FORMS.focusNearest(); } });
})();
</script>
</body>
