    function startTimer() {
      secs = 60; clearInterval(timer);
      const tick = () => {
        timerEl.textContent = secs > 0 ? `Resend available in ${secs}s` : "Didn’t get it? Tap “Send OTP” again.";
        sendBtn.disabled = secs > 0; if (secs-- <= 0) clearInterval(timer);
      };
      tick(); timer = setInterval(tick, 1000);
    }
    sendBtn.addEventListener("click", async () => {
      const ok = Object.keys(rules).map(check).every(Boolean);
      if (!ok) { status.textContent = "Please fix the highlighted fields."; const f = form.querySelector('[aria-invalid="true"]'); if (f) f.focus(); return; }
      status.textContent = "Sending your OTP…"; sendBtn.disabled = true;
      try {
        if (o.live) await post(o.cfg.otpRequestUrl, { mobile: el(p, "mobile").value });
        otpBox.hidden = false; el(p, "mobile").readOnly = true;
